# signoz-ob - SigNoz community server on OceanBase, self-hosted distribution
# image for the AI Vision stack.
#
# Build context is the repository root:
#
#   docker build -f cmd/community/Dockerfile.ob -t signoz-ob .
#   docker buildx build --platform linux/amd64,linux/arm64 -f cmd/community/Dockerfile.ob .
#
# Unlike cmd/community/Dockerfile.multi-arch (which expects a pre-built binary
# and bundles the web frontend), this image compiles the server itself and
# ships no frontend: AI Vision deploys it as a headless query/ingest plane with
# SIGNOZ_WEB_ENABLED=false. The telemetry store is selected at run time via
# SIGNOZ_TELEMETRYSTORE_PROVIDER=oceanbase / SIGNOZ_TELEMETRYSTORE_OCEANBASE_DSN.
#
# The binary is cross-compiled on the build platform (no QEMU): every store
# driver in use (modernc.org/sqlite, go-sql-driver/mysql) is pure Go, which is
# also how the upstream Makefile produces its arm64 build. The final image
# contains only the static binary, CA certificates, templates and license.

# ── Stage 1: build ──────────────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM golang:1.25-bookworm AS builder

ARG TARGETOS
ARG TARGETARCH
# Override for networks where proxy.golang.org is unreachable, e.g.
#   --build-arg GOPROXY=https://goproxy.cn,direct
ARG GOPROXY=https://proxy.golang.org,direct
ENV CGO_ENABLED=0 \
    GOFLAGS=-mod=readonly \
    GOPROXY=${GOPROXY}

WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY cmd/ ./cmd/
COPY pkg/ ./pkg/
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -tags timetzdata -ldflags "-s -w" -o /out/signoz ./cmd/community

# Prepare the few directories required by SQLite and temporary-file users.
# These commands run on BUILDPLATFORM, including when targeting arm64.
RUN mkdir -p /runtime/var/lib/signoz /runtime/tmp /runtime/root \
    && chmod 1777 /runtime/tmp \
    && ln -s /app/templates /runtime/root/templates

# ── Stage 2: runtime ────────────────────────────────────────────────────────
FROM scratch

WORKDIR /app
COPY --from=builder /runtime/ /
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/signoz /app/signoz
COPY LICENSE /app/licenses/SigNoz-LICENSE
# Preserve /app/templates and the default /root/templates path via the symlink.
COPY templates /app/templates

# The sqlite metastore defaults to /var/lib/signoz/signoz.db; mount a volume
# there to persist it across container recreation. Time zones are embedded by
# -tags timetzdata, so no OS tzdata package or Go runtime is needed.
ENV SIGNOZ_WEB_ENABLED=false

# Native probe for scratch containers: ["CMD", "/app/signoz", "healthcheck"].
# When apiserver.address uses another port, pass healthcheck --port <port>.
EXPOSE 8080
ENTRYPOINT ["/app/signoz"]
CMD ["server"]
